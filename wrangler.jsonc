{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ironpin-aerial",
  "main": "./worker.js",
  "compatibility_date": "2026-08-14",
  "assets": {
    "directory": "./dist/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"]
  }
}
